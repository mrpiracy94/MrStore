{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "docker-compose"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)Apps/[^/]+/docker-compose\\.yml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "docker-compose"
      ],
      "automerge": false
    },
    {
      "description": "Rever migrações e backups de bases de dados antes de criar PRs",
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres",
        "docker.io/library/redis",
        "getmeili/meilisearch",
        "docker.io/valkey/valkey",
        "mariadb",
        "postgres"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ],
  "major": {
    "dependencyDashboardApproval": true
  }
}
